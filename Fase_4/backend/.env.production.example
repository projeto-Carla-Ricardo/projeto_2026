# ══════════════════════════════════════════════════════
# AILO — Variáveis de Ambiente (Produção)
# ══════════════════════════════════════════════════════
# Copiar para .env e preencher valores reais

# Flask
SECRET_KEY=GERAR_COM_python_-c_"import secrets; print(secrets.token_hex(32))"
FLASK_ENV=production

# Base de Dados (PostgreSQL)
DATABASE_URL=postgresql://ailo:PASSWORD_SEGURA@db:5432/ailo_db

# Google Gemini (Assistente IA)
GEMINI_API_KEY=SUA_CHAVE_GEMINI_AQUI

# Opcional
CORS_ORIGINS=https://ailo.example.com
LOG_LEVEL=WARNING
